{
  "name": "@zhongjingwei/dsh-model-retry",
  "version": "0.1.0-rc.5",
  "description": "Optional Web settings row for the global model-request retry budget",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/502399493zjw-lgtm/dsh-model-retry.git"
  },
  "homepage": "https://github.com/502399493zjw-lgtm/dsh-model-retry#readme",
  "bugs": {
    "url": "https://github.com/502399493zjw-lgtm/dsh-model-retry/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.json && tsdown",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify:package": "node scripts/verify-package.mjs && pnpm run test",
    "prepack": "pnpm run build && pnpm run verify:package"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.1",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "0.1.0-rc.5",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.5",
    "@deepseek-ai/dsh-llm-retry": "0.1.0-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@tsdown/css": "0.22.14",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.8.3",
    "tsdown": "^0.22.2"
  }
}
